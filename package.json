{
  "name": "kebab-empire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Döner ve kebap işletme oyunu",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json",
    "sim": "node scripts/sim-balance.cjs",
    "sim:year": "node scripts/sim-year.cjs",
    "e2e": "node scripts/e2e.cjs",
    "build:edge": "node scripts/build-edge.mjs",
    "audit:db": "bash tests/db/rls-test.sh",
    "audit:personas": "node scripts/audit/personas.cjs 120 reports/screens",
    "audit:visual": "node scripts/audit/visual.cjs reports/screens",
    "audit:runtime": "node scripts/audit/runtime.cjs",
    "sim:multi": "node scripts/sim-multi.cjs",
    "cap:sync": "npm run build && node -e \"require('fs').readdirSync('dist/assets').filter(f=>f.endsWith('.map')).forEach(f=>require('fs').unlinkSync('dist/assets/'+f))\" && npx cap sync",
    "brand": "node scripts/brand-apply.cjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "acorn": "^8.19.0",
    "eslint-scope": "^9.1.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0"
  }
}
